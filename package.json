    "build": "npm run collect && npm run thumbnails && npm run render",
    "build:no-thumbnails": "npm run collect && npm run render",
    "serve": "node scripts/serve.mjs",
    "test": "node --test test/*.test.mjs"
  },
  "dependencies": {
    "semver": "7.7.2",
    "yaml": "2.8.1"
  },
  "devDependencies": {
