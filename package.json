{
  "name": "@kubohiroya/turbowarp-plus-packages",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Index and dashboard for the TurboWarp Plus family of packages, apps and documentation sites",
  "license": "GPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kubohiroya/turbowarp-plus-packages.git"
  },
  "bugs": {
    "url": "https://github.com/kubohiroya/turbowarp-plus-packages/issues"
  },
  "homepage": "https://kubohiroya.github.io/turbowarp-plus-packages/",
  "scripts": {
    "collect": "node --import tsx scripts/collect.ts",
    "thumbnails": "node --import tsx scripts/thumbnails.ts",
    "render": "node --import tsx scripts/render.ts",
    "icons": "node --import tsx scripts/icons.ts",
    "build": "npm run collect && npm run thumbnails && npm run render",
    "build:no-thumbnails": "npm run collect && npm run render",
    "serve": "node --import tsx scripts/serve.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test test/*.test.ts"
  },
  "dependencies": {
    "semver": "7.7.2",
    "yaml": "2.8.1"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/semver": "7.8.0",
    "playwright": "1.59.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=22"
  }
}
