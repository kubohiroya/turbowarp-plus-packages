{
  "name": "@kubohiroya/turbowarp-plus-packages",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Index and dashboard for the TurboWarp Plus family of packages, apps and documentation sites",
  "license": "GPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kubohiroya/turbowarp-plus-packages.git"
  },
  "bugs": {
    "url": "https://github.com/kubohiroya/turbowarp-plus-packages/issues"
  },
  "homepage": "https://kubohiroya.github.io/turbowarp-plus-packages/",
  "scripts": {
    "bump": "node --import tsx scripts/bump.ts",
    "bump:downstream": "node --import tsx scripts/bump-downstream.ts",
    "upstream:sync": "node --import tsx scripts/upstream-sync.ts",
    "collect": "node --import tsx scripts/collect.ts",
    "thumbnails": "node --import tsx scripts/thumbnails.ts",
    "render": "node --import tsx scripts/render.ts",
    "icons": "node --import tsx scripts/icons.ts",
    "build": "npm run collect && npm run editor:catalog && npm run thumbnails && npm run render",
    "build:no-thumbnails": "npm run collect && npm run editor:catalog && npm run render",
    "serve": "node --import tsx scripts/serve.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test test/*.test.ts",
    "release": "node --import tsx scripts/release.ts",
    "release:chain": "node --import tsx scripts/release-chain.ts",
    "release:status": "node --import tsx scripts/release-status.ts",
    "release:tasks": "node --import tsx scripts/release-tasks.ts",
    "release:finish": "node --import tsx scripts/release-finish.ts",
    "editor:catalog": "node --import tsx scripts/editor-catalog.ts"
  },
  "dependencies": {
    "semver": "7.8.6",
    "yaml": "2.9.1",
    "@kubohiroya/turbowarp-extension-manifest": "0.6.0"
  },
  "devDependencies": {
    "@types/node": "22.20.7",
    "@types/semver": "7.8.0",
    "playwright": "1.65.1",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=22"
  }
}
