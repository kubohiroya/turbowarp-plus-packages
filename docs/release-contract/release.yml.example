name: Release
on:
  workflow_dispatch:
    inputs:
      version:
        description: Verified release version (without v)
        required: true
        type: string
permissions:
  contents: read
concurrency:
  group: npm-release
  cancel-in-progress: false
jobs:
  publish:
    if: github.ref == format('refs/heads/{0}', github.event.repository.default_branch)
    runs-on: ubuntu-latest
    permissions:
      contents: read
      id-token: write
    steps:
      - uses: actions/checkout@v4
        with:
          fetch-depth: 0
      - uses: actions/setup-node@v7
        with:
          node-version: '24'
      - run: npm install --global npm@11.21.0 semver@7.7.2
      - name: Check the release source
        env:
          VERSION: ${{ inputs.version }}
        run: |
          node -e 'if (!/^[0-9]+\.[0-9]+\.[0-9]+(?:-[0-9A-Za-z.-]+)?$/.test(process.env.VERSION)) throw Error("Invalid release version")'
          node -e 'const p=require("./package.json");if(p.version!==process.env.VERSION || p.private || !p.name.startsWith("@kubohiroya/")) throw Error("Unexpected package identity")'
          # The release tag must point at the commit this run publishes from.
          test "$(git rev-list -n 1 "v$VERSION")" = "$GITHUB_SHA"
      - run: npm ci
      - name: Publish from the checkout and synchronize channels
        env:
          VERSION: ${{ inputs.version }}
        run: |
          export SEMVER_PATH="$(npm root -g)/semver"
          node <<'NODE'
          const {execFileSync}=require('node:child_process');
          const semver=require(process.env.SEMVER_PATH);
          const name=require('./package.json').name;
          const version=process.env.VERSION;
          const read=()=>JSON.parse(execFileSync('npm',['view',name,'dist-tags','--json','--prefer-online'],{encoding:'utf8'}));
          const before=read();
          for (const tag of ['latest','next']) {
            if (semver.valid(before[tag]) && semver.gt(before[tag],version)) throw Error(`Refusing to downgrade ${tag}`);
          }
          require('node:fs').writeFileSync('before-tags.json', JSON.stringify(before));
          NODE
          # npm packs this checkout itself and records its commit as gitHead; no tarball is handled here.
          npm publish --access public --tag next --provenance
          node <<'NODE'
          const {execFileSync}=require('node:child_process');
          const name=require('./package.json').name;
          const version=process.env.VERSION;
          const before=require('./before-tags.json');
          const read=()=>JSON.parse(execFileSync('npm',['view',name,'dist-tags','--json','--prefer-online'],{encoding:'utf8'}));
          for (const tag of ['latest','next']) {
            const current=read();
            if (![before[tag],version].includes(current[tag])) throw Error(`Concurrent change to ${tag}`);
            if (current[tag]!==version) execFileSync('npm',['dist-tag','add',`${name}@${version}`,tag],{stdio:'inherit'});
          }
          NODE
